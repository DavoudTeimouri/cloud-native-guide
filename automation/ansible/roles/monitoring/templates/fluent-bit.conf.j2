[SERVICE]
    Flush         5
    Log_Level     info
    Daemon        off
    Parsers_File  parsers.conf
    HTTP_Server   On
    HTTP_Listen   0.0.0.0
    HTTP_Port     2020

[INPUT]
    Name              tail
    Path              /var/log/containers/*.log
    Parser            docker
    Tag               kube.*
    Refresh_Interval  10
    Mem_Buf_Limit     50MB
    Skip_Long_Lines   On

[INPUT]
    Name              systemd
    Tag               host.*
    Systemd_Filter    _SYSTEMD_UNIT=containerd.service
    Systemd_Filter    _SYSTEMD_UNIT=kubelet.service
    Systemd_Filter    _SYSTEMD_UNIT=chronyd.service
    Systemd_Filter    _SYSTEMD_UNIT=sshd.service

[FILTER]
    Name                kubernetes
    Match               kube.*
    Kube_URL            https://kubernetes.default.svc:443
    Kube_CA_File        /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
    Kube_Token_File     /var/run/secrets/kubernetes.io/serviceaccount/token
    Labels              On
    Annotations         Off
    Merge_Log           On
    Merge_Log_Key       log_processed
    K8S-Logging.Parser  On
    K8S-Logging.Exclude On

[FILTER]
    Name          modify
    Match         *
    Add           cluster {{ cluster_name | default('unknown') }}
    Add           environment {{ env | default('unknown') }}
    {% for key, value in monitoring_fluent_bit_extra_labels.items() %}
    Add           {{ key }} {{ value }}
    {% endfor %}

[OUTPUT]
    Name            loki
    Match           *
    Url             {{ monitoring_fluent_bit_loki_url }}
    BatchWait       1
    BatchSize       10240
    LineFormat      json
    Labels          {job="fluent-bit"}
    RemoveKeys      docker
    AutoKubernetesLabels on