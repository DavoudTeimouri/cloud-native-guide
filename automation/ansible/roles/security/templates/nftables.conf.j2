#!/usr/sbin/nft -f
# nftables firewall configuration - managed by Ansible
# DO NOT EDIT THIS FILE DIRECTLY

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority 0; policy {{ security_firewall_default_policy }};
        ct state established,related accept
        iif "lo" accept

        # SSH - restricted to allowed source CIDRs
        {% for cidr in security_firewall_allowed_source_cidrs %}
        ip saddr {{ cidr }} tcp dport 22 ct state new accept
        {% endfor %}

        # Kubernetes API
        tcp dport 6443 ct state new accept

        # etcd
        tcp dport 2379-2380 ct state new accept

        # kubelet
        tcp dport 10250 ct state new accept

        # kube-scheduler
        tcp dport 10259 ct state new accept

        # kube-controller-manager
        tcp dport 10257 ct state new accept

        # NodePort range
        tcp dport 30000-32767 ct state new accept

        # VXLAN (Cilium)
        udp dport 8472 ct state new accept

        # ICMP
        {% for icmp_type in security_firewall_allowed_icmp %}
        icmp type {{ icmp_type }} accept
        {% endfor %}

        # Drop invalid
        ct state invalid drop
    }

    chain forward {
        type filter hook forward priority 0; policy {{ security_firewall_default_policy }};
        ct state established,related accept
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}