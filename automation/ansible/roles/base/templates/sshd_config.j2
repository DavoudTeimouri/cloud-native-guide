# SSH daemon configuration - managed by Ansible
# DO NOT EDIT THIS FILE DIRECTLY

Port 22
Protocol 2

# Authentication
PermitRootLogin {{ base_ssh_hardening.permit_root_login }}
PasswordAuthentication {{ base_ssh_hardening.password_authentication }}
PubkeyAuthentication {{ base_ssh_hardening.pubkey_authentication }}
PermitEmptyPasswords {{ base_ssh_hardening.permit_empty_passwords }}
ChallengeResponseAuthentication {{ base_ssh_hardening.challenge_response_authentication }}
UsePAM {{ base_ssh_hardening.use_pam }}

# Network
X11Forwarding {{ base_ssh_hardening.x11_forwarding }}
AllowTcpForwarding {{ base_ssh_hardening.allow_tcp_forwarding }}
ClientAliveInterval {{ base_ssh_hardening.client_alive_interval }}
ClientAliveCountMax {{ base_ssh_hardening.client_alive_count_max }}
MaxAuthTries {{ base_ssh_hardening.max_auth_tries }}
MaxSessions {{ base_ssh_hardening.max_sessions }}
LoginGraceTime {{ base_ssh_hardening.login_grace_time }}
Banner {{ base_ssh_hardening.banner }}

# Security
AllowUsers ansible ansible-user
DenyUsers root daemon bin sys sync games man lp mail news uucp proxy www-data backup list irc gnats nobody systemd-network systemd-resolve systemd-timesync messagebus syslog _apt

# Logging
SyslogFacility AUTH
LogLevel INFO

# Performance
MaxStartups 10:30:60