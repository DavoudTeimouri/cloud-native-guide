# Containerd configuration - managed by Ansible
# DO NOT EDIT THIS FILE DIRECTLY

version = 2

[plugins."io.containerd.grpc.v1.cri"]
  sandbox_image = "{{ containerd_sandbox_image }}"
  max_container_log_line_size = {{ containerd_max_container_log_line_size }}

  [plugins."io.containerd.grpc.v1.cri".containerd]
    snapshotter = "overlayfs"
    default_runtime_name = "runc"

    [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc]
      runtime_type = "io.containerd.runc.v2"
      [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc.options]
        SystemdCgroup = {{ containerd_systemd_cgroup | lower }}

  [plugins."io.containerd.grpc.v1.cri".cni]
    bin_dir = "/opt/cni/bin"
    conf_dir = "/etc/cni/net.d"

  {% for registry, config in containerd_registry_mirrors.items() %}
  [plugins."io.containerd.grpc.v1.cri".registry.mirrors."{{ registry }}"]
    endpoint = {{ config.endpoint | to_json }}
  {% endfor %}

  [plugins."io.containerd.grpc.v1.cri".registry.configs."harbor.internal".tls]
    ca_file = "/etc/containerd/certs.d/harbor.internal/ca.crt"