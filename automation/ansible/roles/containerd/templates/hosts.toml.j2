# Containerd registry mirror configuration - managed by Ansible
# DO NOT EDIT THIS FILE DIRECTLY

server = "{{ item.value.endpoint[0] }}"

[host."{{ item.value.endpoint[0] }}".capabilities]
  pull = true
  resolve = true
  push = false

{% if item.value.tls is defined %}
[host."{{ item.value.endpoint[0] }}".tls]
  ca_file = "{{ item.value.tls.ca_file }}"
  {% if item.value.tls.insecure is defined %}
  insecure_skip_verify = {{ item.value.tls.insecure | lower }}
  {% endif %}
{% endif %}